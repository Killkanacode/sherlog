From fcc817e424dd2545a843d49dc5b5da37866e18d4 Mon Sep 17 00:00:00 2001
From: Miguel Bustamante Feijoo <miguelbustamantef@gmail.com>
Date: Thu, 29 Oct 2026 02:09:16 -0500
Subject: [PATCH] orders: add bundle promotions to checkout

Orders that contain every SKU of a promotional bundle get 5% off.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JVcxrbLTzduCswWdArkU73
---
 demo-app/orders/main.py    |  1 +
 demo-app/orders/pricing.py | 25 +++++++++++++++++++++++++
 2 files changed, 26 insertions(+)

diff --git a/demo-app/orders/main.py b/demo-app/orders/main.py
index ffb49ee..5440380 100644
--- a/demo-app/orders/main.py
+++ b/demo-app/orders/main.py
@@ -93,6 +93,7 @@ async def create_order(req: CreateOrder):
             total = pricing.order_total_volume_discount(lines)
         else:
             total = pricing.order_total(lines)
+            total -= pricing.bundle_discount_cents(lines, total)
 
         try:
             charge = await payments.request(
diff --git a/demo-app/orders/pricing.py b/demo-app/orders/pricing.py
index 184444e..0f12ef7 100644
--- a/demo-app/orders/pricing.py
+++ b/demo-app/orders/pricing.py
@@ -6,6 +6,31 @@ the new pricing engine, rolled out behind the `new_pricing` feature flag.
 
 VOLUME_DISCOUNT_TIERS = ((10, 0.10), (5, 0.05))  # (min units, discount)
 
+# Bundle promotions: buying every SKU of a bundle takes 5% off the order.
+BUNDLES = [
+    frozenset(
+        {
+            f"SKU-{(i * 37) % 5000 + 1:07d}",
+            f"SKU-{(i * 91) % 5000 + 1:07d}",
+            f"SKU-{(i * 13) % 5000 + 1:07d}",
+        }
+    )
+    for i in range(1, 4000)
+]
+BUNDLE_DISCOUNT = 0.05
+
+
+def active_bundles() -> list[frozenset]:
+    """Bundles not contained in a larger bundle, so discounts never stack."""
+    return [a for a in BUNDLES if not any(b is not a and a <= b for b in BUNDLES)]
+
+
+def bundle_discount_cents(lines: list[dict], total_cents: int) -> int:
+    skus = {line["sku"] for line in lines}
+    if any(bundle <= skus for bundle in active_bundles()):
+        return int(total_cents * BUNDLE_DISCOUNT)
+    return 0
+
 
 def order_total(lines: list[dict]) -> int:
     """Total in cents for reserved lines (each with unit_price in cents)."""

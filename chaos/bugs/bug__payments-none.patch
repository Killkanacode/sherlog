From 63e314b41f63edef247e2551595ae9b57ee5b1c0 Mon Sep 17 00:00:00 2001
From: Miguel Bustamante Feijoo <miguelbustamantef@gmail.com>
Date: Thu, 29 Oct 2026 02:09:16 -0500
Subject: [PATCH] payments: derive charge status from provider status field

Read status and authorization code straight from the provider response.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JVcxrbLTzduCswWdArkU73
---
 demo-app/payments/main.py | 13 ++-----------
 1 file changed, 2 insertions(+), 11 deletions(-)

diff --git a/demo-app/payments/main.py b/demo-app/payments/main.py
index cf3f501..094c79e 100644
--- a/demo-app/payments/main.py
+++ b/demo-app/payments/main.py
@@ -55,17 +55,8 @@ async def charge(req: ChargeRequest):
         return json.loads(previous)
 
     result = await provider.authorize(req.amount_cents, req.currency)
-    authorization = result.get("authorization")
-    if authorization is None:
-        status, auth_code = "pending", None
-        log.info(
-            "Charge %s for order %s is pending provider review",
-            result["id"],
-            req.order_ref,
-            extra={"charge_id": result["id"], "order_ref": req.order_ref},
-        )
-    else:
-        status, auth_code = "approved", authorization["code"]
+    status = "approved" if result["status"] == "approved" else "pending"
+    auth_code = result["authorization"]["code"]
 
     response = {
         "charge_id": result["id"],
-- 

# Copy to .env and fill in. Never commit .env.

# Use stand-in models instead of calling any model API (local development only;
# their output is not a diagnosis).
SHERLOG_FAKE_LLM=false

# Meta Model API — TODO(VERIFY) against the official docs
META_API_BASE_URL=
META_API_KEY=
MODEL_INVESTIGATOR=          # Muse Spark
MODEL_VOICE=                 # Muse Voice Transcribe
MUSE_CODE_MODE=              # api | cli — TODO(VERIFY)

# Prices in USD per million tokens (TODO(VERIFY)); leave empty and cost shows as unknown
MODEL_INVESTIGATOR_PRICE_IN=
MODEL_INVESTIGATOR_PRICE_OUT=

# Muse Spark Open (Modal or Baseten)
OPEN_MODEL_PROVIDER=baseten  # baseten | modal
OPEN_MODEL_BASE_URL=
OPEN_MODEL_API_KEY=
OPEN_MODEL_ID=meta-models/muse-spark-open-1026

OPEN_MODEL_PRICE_IN=
OPEN_MODEL_PRICE_OUT=

# GitHub (fixer PRs against the demo app repo)
GITHUB_TOKEN=
DEMO_APP_REPO=owner/sherlog

# Sherlog
SHERLOG_AUTONOMY=L1                 # L0 suggest only | L1 approve every action | L2 auto for low-risk actions
SHERLOG_DRY_RUN=false
SHERLOG_AUTO_MIN_CONFIDENCE=0.7     # L2 acts on its own only above this diagnosis confidence
SHERLOG_MAX_ACTION_CYCLES=2         # failed mitigations before escalating
SHERLOG_VERIFY_TIMEOUT_S=180
SHERLOG_VERIFY_HEALTHY_S=30
SHERLOG_MAX_STEPS=12
SHERLOG_TOKEN_BUDGET_PER_INCIDENT=60000
SHERLOG_TOOL_TIMEOUT_S=20
SHERLOG_MONTHLY_SPEND_LIMIT_USD=100     # model calls stop for the month at this spend (needs prices above)
SHERLOG_MONTHLY_TOKEN_LIMIT=0           # same, in tokens (0 = no limit)
SHERLOG_MAX_CONCURRENT_INVESTIGATIONS=2 # more incidents than this queue for a free investigator
SHERLOG_MAX_ACTIONS_PER_HOUR=6          # automatic actions (L2) per hour; beyond, they wait for approval
SHERLOG_SERVICE_COOLDOWN_S=600          # no automatic action on a service changed this recently

# Access. Generate tokens with: python3 -c "import secrets; print('slg_' + secrets.token_urlsafe(32))"
# SHERLOG_ADMIN_TOKEN is the first admin's API key (if unset, one is generated and logged once).
# SHERLOG_API_KEYS adds keys as name:role:sha256(token), comma-separated; roles: viewer, operator, admin.
SHERLOG_ADMIN_TOKEN=
SHERLOG_API_KEYS=
SHERLOG_SECRET_KEY=                     # signs console sessions; generated and stored if unset
SHERLOG_EVENTS_TOKEN=                   # shared with platform-api for its event push
SHERLOG_SECURE_COOKIES=false            # true when the console is served over HTTPS
SHERLOG_CORS_ORIGINS=                   # empty: the API only answers its own origin

# Internal endpoints
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
TEMPO_URL=http://tempo:3200
PLATFORM_API_URL=http://platform-api:8050

# Demo app
POSTGRES_PASSWORD=shop
LOCUST_USERS=30

# Host port for the shop gateway (container port is always 8000)
GATEWAY_HOST_PORT=8000
# Host port for Sherlog's web console
WEB_HOST_PORT=8300
